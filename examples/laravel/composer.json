{
  "name": "cluion/sigil-laravel-example",
  "type": "project",
  "description": "Runnable Sigil activity-page editor with authenticated persistence",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-pdo_sqlite": "*",
    "laravel/framework": "13.36.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.12",
    "phpunit/phpunit": "12.5.36"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "php scripts/test.php"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "cache-read-only": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
